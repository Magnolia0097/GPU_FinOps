# 실제 값은 .env 에 넣고 커밋하지 않는다.

# AWS — 스팟 가격 이력 조회용 (조회 자체는 무과금)
# Price List Bulk API 는 인증 불필요하므로 이 값이 없어도 온디맨드 가격은 수집된다.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-northeast-2

# 로컬 인프라 (Week 2 구성 예정)
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=gpu_finops
